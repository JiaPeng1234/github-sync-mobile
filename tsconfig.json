{
  "compilerOptions": {
    "baseUrl": ".",
    "noEmit": true,
    "module": "ESNext",
    "target": "ES2018",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "isolatedModules": true,
    "strict": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "lib": ["ES2018", "DOM"],
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
